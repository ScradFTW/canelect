# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string (server-only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional: Google Analytics 4 measurement ID. Analytics is off when unset.
# Public — inlined into the browser bundle at build time.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: canonical site URL used for Open Graph links
NEXT_PUBLIC_SITE_URL=https://electionmap.bradjobe.dev
